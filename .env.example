# Copy this file to ".env" and fill in what you have. Never commit ".env".
# Only TALANTON_CONTACT is required (and only to download from the SEC).

# Your name and e-mail: the SEC asks every caller to identify itself.
TALANTON_CONTACT="First Last first.last@example.com"

# Optional free keys.
# FRED_API_KEY=            # https://fred.stlouisfed.org/docs/api/api_key.html (without it, public CSV files are used)
# ALPHAVANTAGE_API_KEY=    # https://www.alphavantage.co/support/#api-key (backup prices)
# FINNHUB_API_KEY=         # https://finnhub.io/register (backup prices, peer suggestions)

# Terminal edition: set to 1 on a computer with a logged-in Bloomberg Terminal.
# TALANTON_BLOOMBERG=1
